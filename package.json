{
  "name": "empira-conquest",
  "version": "0.1.0",
  "private": true,
  "description": "Empira Conquest — jeu de conquête interactif pour TikTok LIVE (prototype)",
  "type": "module",
  "scripts": {
    "start": "node server/server.js --open",
    "dev": "node server/server.js",
    "tiktok": "node server/server.js --open --tiktok",
    "test": "node --test \"tests/*.test.js\"",
    "test:e2e": "node tests/e2e/smoke.mjs",
    "build:map": "node tools/build-france-map.mjs",
    "build:produit": "node tools/build-produit.mjs",
    "test:produit": "node tools/build-produit.mjs && node tests/e2e/produit.mjs",
    "dev:produit": "node tools/build-produit.mjs && node tools/serveur-produit.mjs dist/dev"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "esbuild": "^0.24.2"
  }
}
